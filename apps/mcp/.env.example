# apps/mcp: copy to .env.local. On Vercel, set these on the mcp project.

# Neon Postgres (same database as apps/web)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Full public URL of this endpoint (must equal MCP_URL in apps/web)
MCP_URL=http://localhost:3001/api/mcp
# The website's Better Auth issuer: <web BETTER_AUTH_URL>/api/auth
AUTH_ISSUER=http://localhost:3000/api/auth
