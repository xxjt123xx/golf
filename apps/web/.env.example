# apps/web: copy to .env.local. On Vercel, set these on the web project.

# Public URL of the website, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ char secret: `npx auth secret`
BETTER_AUTH_SECRET=
# Neon Postgres (shared with apps/mcp)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Google OAuth client. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full URL of the MCP endpoint served by apps/mcp
MCP_URL=http://localhost:3001/api/mcp
