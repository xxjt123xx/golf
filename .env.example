# Copy to .env.local for local dev. On Vercel, set these in Project > Settings > Environment Variables.

# Public URL of the app, no trailing slash (Vercel: https://your-app.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ char secret: `npx auth secret`
BETTER_AUTH_SECRET=

# Neon Postgres connection string (Vercel Marketplace > Neon adds this automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
